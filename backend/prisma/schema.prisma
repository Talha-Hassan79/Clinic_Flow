// ClinicFlow Prisma Schema
// Database: PostgreSQL | ORM: Prisma | Keys: UUID | Soft Deletes: deletedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// CLINICS
// ─────────────────────────────────────────────
model Clinic {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(150)
  email              String    @db.VarChar(150)
  phone              String?   @db.VarChar(30)
  address            String?   @db.Text
  city               String?   @db.VarChar(100)
  country            String?   @db.VarChar(100)
  postalCode         String?   @db.VarChar(20)
  timezone           String?   @db.VarChar(50)
  currency           String?   @db.VarChar(20)
  logoUrl            String?   @db.Text
  subscriptionPlan   String?   @db.VarChar(30)
  subscriptionStatus String?   @db.VarChar(30)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  users          User[]
  doctors        Doctor[]
  patients       Patient[]
  departments    Department[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  medicines      Medicine[]
  invoices       Invoice[]
  payments       Payment[]
  medicalRecords MedicalRecord[]
  labReports     LabReport[]
  labCatalogs    LabTestCatalog[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("clinics")
}

// ─────────────────────────────────────────────
// ROLES & PERMISSIONS (RBAC)
// ─────────────────────────────────────────────
model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// USERS & INVITATIONS
// ─────────────────────────────────────────────
enum UserInvitationStatus {
  INVITED
  ACCEPTED
  DECLINED
  ACTIVE
}

model User {
  id               String               @id @default(uuid())
  clinicId         String
  roleId           String
  firstName        String               @db.VarChar(100)
  lastName         String               @db.VarChar(100)
  email            String               @unique @db.VarChar(150)
  passwordHash     String               @db.Text
  phone            String?              @db.VarChar(30)
  avatarUrl        String?              @db.Text
  isActive         Boolean              @default(true)
  invitationStatus UserInvitationStatus @default(ACTIVE)
  invitationToken  String?              @unique @db.VarChar(100)
  lastLogin        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @db.Text
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// DEPARTMENTS
// ─────────────────────────────────────────────
model Department {
  id          String    @id @default(uuid())
  clinicId    String
  name        String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  doctors Doctor[]

  @@map("departments")
}

// ─────────────────────────────────────────────
// DOCTORS
// ─────────────────────────────────────────────
model Doctor {
  id              String    @id @default(uuid())
  clinicId        String
  departmentId    String?
  userId          String?   @unique
  specialization  String?   @db.VarChar(100)
  licenseNumber   String?   @db.VarChar(50)
  qualification   String?   @db.VarChar(200)
  experienceYears Int?
  consultationFee Decimal?  @db.Decimal(10, 2)
  bio             String?   @db.Text
  isAvailable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  clinic        Clinic          @relation(fields: [clinicId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  appointments  Appointment[]
  prescriptions Prescription[]
  medicalRecords MedicalRecord[]
  labReports    LabReport[]

  @@map("doctors")
}

// ─────────────────────────────────────────────
// PATIENTS
// ─────────────────────────────────────────────
model Patient {
  id                    String    @id @default(uuid())
  clinicId              String
  firstName             String    @db.VarChar(100)
  lastName              String    @db.VarChar(100)
  gender                String?   @db.VarChar(20)
  dateOfBirth           DateTime?
  bloodGroup            String?   @db.VarChar(10)
  phone                 String?   @db.VarChar(30)
  email                 String?   @db.VarChar(150)
  cnic                  String?   @db.VarChar(20)
  address               String?   @db.Text
  city                  String?   @db.VarChar(100)
  emergencyContactName  String?   @db.VarChar(100)
  emergencyContactPhone String?   @db.VarChar(30)
  allergies             String?   @db.Text
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]
  prescriptions  Prescription[]
  medicalRecords MedicalRecord[]
  invoices       Invoice[]
  labReports     LabReport[]

  @@index([phone])
  @@index([email])
  @@index([cnic])
  @@map("patients")
}

// ─────────────────────────────────────────────
// APPOINTMENTS
// ─────────────────────────────────────────────
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  clinicId        String
  patientId       String
  doctorId        String
  appointmentDate DateTime          @db.Date
  appointmentTime String            @db.VarChar(10)
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?           @db.Text
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  prescription Prescription?
  invoice      Invoice?

  @@index([appointmentDate])
  @@index([status])
  @@index([doctorId])
  @@index([patientId])
  @@map("appointments")
}

// ─────────────────────────────────────────────
// MEDICAL RECORDS
// ─────────────────────────────────────────────
model MedicalRecord {
  id             String    @id @default(uuid())
  clinicId       String
  patientId      String
  doctorId       String
  visitDate      DateTime  @db.Date
  chiefComplaint String?   @db.Text
  history        String?   @db.Text
  examination    String?   @db.Text
  diagnosis      String?   @db.Text
  treatment      String?   @db.Text
  attachments    String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@map("medical_records")
}

// ─────────────────────────────────────────────
// PRESCRIPTIONS
// ─────────────────────────────────────────────
model Prescription {
  id             String    @id @default(uuid())
  clinicId       String
  appointmentId  String    @unique
  patientId      String
  doctorId       String
  diagnosis      String?   @db.Text
  instructions   String?   @db.Text
  followUpDate   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  appointment Appointment        @relation(fields: [appointmentId], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctor      Doctor             @relation(fields: [doctorId], references: [id])
  items       PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String? @db.VarChar(100)
  frequency      String? @db.VarChar(100)
  duration       String? @db.VarChar(100)
  quantity       Int?
  notes          String? @db.Text

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("prescription_items")
}

// ─────────────────────────────────────────────
// MEDICINES
// ─────────────────────────────────────────────
model Medicine {
  id           String    @id @default(uuid())
  clinicId     String
  name         String    @db.VarChar(200)
  genericName  String?   @db.VarChar(200)
  manufacturer String?   @db.VarChar(200)
  strength     String?   @db.VarChar(50)
  unit         String?   @db.VarChar(30)
  price        Decimal?  @db.Decimal(10, 2)
  stock        Int       @default(0)
  reorderLevel Int       @default(10)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  clinic             Clinic             @relation(fields: [clinicId], references: [id])
  prescriptionItems  PrescriptionItem[]

  @@map("medicines")
}

// ─────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────
enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  clinicId      String
  patientId     String
  appointmentId String?       @unique
  invoiceNumber String        @unique @db.VarChar(50)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  payments    Payment[]

  @@index([status])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  JAZZ_CASH
  EASY_PAISA
  ONLINE
}

model Payment {
  id                   String        @id @default(uuid())
  clinicId             String
  invoiceId            String
  paymentMethod        PaymentMethod
  amount               Decimal       @db.Decimal(10, 2)
  transactionReference String?       @db.VarChar(100)
  paymentDate          DateTime      @default(now())
  notes                String?       @db.Text
  createdAt            DateTime      @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentDate])
  @@map("payments")
}

// ─────────────────────────────────────────────
// LAB REPORTS
// ─────────────────────────────────────────────
enum LabVerificationStatus {
  PENDING_TECH_ENTRY
  PENDING_PATHOLOGIST_APPROVAL
  APPROVED
  CANCELLED
}

model LabReport {
  id                   String               @id @default(uuid())
  clinicId             String
  patientId            String
  doctorId             String
  reportName           String               @db.VarChar(200)
  fileUrl              String               @db.Text
  uploadedAt           DateTime             @default(now())
  // LIMS advanced fields
  sampleToken          String?              @db.VarChar(30)
  sampleCollectedAt    DateTime?
  verificationStatus   LabVerificationStatus @default(PENDING_TECH_ENTRY)
  pathologistId        String?
  pathologistSignedAt  DateTime?
  pathologistNotes     String?              @db.Text

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@map("lab_reports")
}

// ─────────────────────────────────────────────
// LAB TEST CATALOG (Custom Test Definitions)
// ─────────────────────────────────────────────
model LabTestCatalog {
  id          String   @id @default(uuid())
  clinicId    String
  name        String   @db.VarChar(200)
  category    String   @db.VarChar(100)
  description String?  @db.Text
  price       Decimal  @default(0) @db.Decimal(10, 2)
  turnaround  String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic     Clinic               @relation(fields: [clinicId], references: [id])
  parameters LabCatalogParameter[]

  @@index([clinicId])
  @@map("lab_test_catalog")
}

model LabCatalogParameter {
  id          String  @id @default(uuid())
  catalogId   String
  paramKey    String  @db.VarChar(100)
  paramLabel  String  @db.VarChar(150)
  unit        String  @db.VarChar(50)
  normalRange String  @db.VarChar(100)
  sortOrder   Int     @default(0)

  catalog LabTestCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@map("lab_catalog_parameters")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────
enum NotificationType {
  APPOINTMENT
  BILLING
  REMINDER
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  clinicId  String
  userId    String
  title     String           @db.VarChar(200)
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  oldValues Json?
  newValues Json?
  ipAddress String?  @db.VarChar(50)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
